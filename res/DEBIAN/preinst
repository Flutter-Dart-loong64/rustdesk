#!/bin/bash

set -e

case $1 in
    install|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		if [ "systemd" == "${INITSYS}" ]; then
			if systemctl cat rustdesk.service >/dev/null 2>&1; then
				systemctl stop rustdesk.service >/dev/null 2>&1 || true
			fi
      sleep 1
      rm -rf /usr/bin/libsciter-gtk.so
		fi
        ;;
esac

exit 0
